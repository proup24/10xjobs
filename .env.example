# Local development: copy to .env. Supabase runs through the CLI (`pnpm db:start`).
# Local Redis host port (container port remains 6379).
REDIS_PORT=6379
REDIS_CACHE_PORT=6380
REDIS_CACHE_MAXMEMORY=128mb
# The API/worker env loader expands these port references.
REDIS_URL=redis://127.0.0.1:${REDIS_PORT}
REDIS_CACHE_URL=redis://127.0.0.1:${REDIS_CACHE_PORT}
REDIS_PREFIX=xjobs
REDIS_COMMAND_TIMEOUT_MS=3000
CACHE_TTL_SECONDS=300
JOBS_CONCURRENCY=5
# Worker process only: unset runs the infrastructure worker; a channel runs that
# channel's collection job (LINKEDIN_JOB_BOARD, LINKEDIN_POSTS, GREEN_HOUSE, ASHBY).
# WORKER_CHANNEL=
# XJOBS_RUN_SCHEDULES=  # hosted engine only; never set locally. Without it workers register no schedules and remove old ones.
############
# Application - NestJS API (validated by apps/xjobs/src/config/environment.validation.ts)
############

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
SYSTEM_DOMAIN=localhost
# SENTRY_DSN=
# COOKIE_DOMAIN=
# COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Shared secret: every API request, health included, must send it as the
# X-Engine-Key header. At least 32 characters; the web app uses the same value.
# openssl rand -base64 48
ENGINE_API_KEY=
# Mounts the operator routes (processor, matcher, query search), which need only
# the engine key. Local only; validation refuses it when NODE_ENV=production.
XJOBS_OPERATOR_ENDPOINTS=1

# Supabase Storage (resume PDFs). Server-side service-role access only; never
# expose this key to a browser.
SUPABASE_URL=http://127.0.0.1:54321
# copy from `pnpm db:status`
SUPABASE_SERVICE_ROLE_KEY=

# Apify API token for the job collectors (LinkedIn and Google discovery).
# Optional: the API boots without it, and collection fails until it is set.
# APIFY_TOKEN=

# Prisma 8 runtime connection: the Supabase CLI's local Postgres. For hosted
# Supabase use the session pooler URL (port 5432), never the transaction pooler (6543):
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional separate connection for the Prisma CLI (migrations); defaults to DATABASE_URL.
# DIRECT_DATABASE_URL=
DATABASE_CONNECTION_TIMEOUT_MS=20000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_SLOW_QUERY_MS=500
DATABASE_LOG_QUERIES=false

# Claude credential for the processor, which runs the generator through
# `claude -p` (Claude Code, pinned version on PATH). Use the subscription token
# from `claude setup-token`, or an Anthropic API key instead.
# Required when WORKER_ROLE=processor. WORKER_ROLE=all (worker-all) runs the
# processor whenever one is set, and the API's /processor endpoints need it.
# Set it only in untracked env files.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# PROCESSOR_EXTRACTION_MODEL=claude-sonnet-5-5
# PROCESSOR_EFFORT=low
# PROCESSOR_CALL_TIMEOUT_MS=180000
# Weekly utilization (0 to 1) at which processing stops until the reset.
# PROCESSOR_WEEKLY_STOP_AT=0.85
# PROCESSOR_CONCURRENCY=4
# PROCESSOR_MAX_ATTEMPTS=3
# PROCESSOR_CLAIM_TIMEOUT_MS=900000
# Daily spend cap in USD (the CLI's list-price figure); 0 means no cap.
# PROCESSOR_DAILY_BUDGET_USD=0
# PROCESSOR_GENERATION_TRIES=3

# Shared dev database (Supabase Cloud): see docs/shared-dev-database.md.
# To use it, comment out the local DATABASE_URL, SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY above and uncomment these. Never set
# XJOBS_ALLOW_REMOTE_DB in this file; the pnpm db commands ignore it here, but
# Nx loads this file into task env.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
