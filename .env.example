# Local development: copy to .env. Supabase runs through the CLI (`pnpm db:start`).
# Local Redis host port (container port remains 6379).
REDIS_PORT=6379
REDIS_CACHE_PORT=6380
REDIS_CACHE_MAXMEMORY=128mb
# The API/worker env loader expands these port references.
REDIS_URL=redis://127.0.0.1:${REDIS_PORT}
REDIS_CACHE_URL=redis://127.0.0.1:${REDIS_CACHE_PORT}
REDIS_PREFIX=xjobs
REDIS_COMMAND_TIMEOUT_MS=3000
CACHE_TTL_SECONDS=300
JOBS_CONCURRENCY=5
############
# Application - NestJS API (validated by apps/xjobs/src/config/environment.validation.ts)
############

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
SYSTEM_DOMAIN=localhost
# SENTRY_DSN=
# COOKIE_DOMAIN=
# COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# HTTP Basic auth for every API route except the GET /api health check.
# Use a long random password (at least 12 characters), e.g. openssl rand -base64 24.
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change-me-to-a-long-random-password

# Supabase Storage (resume PDFs). Server-side service-role access only; never
# expose this key to a browser.
SUPABASE_URL=http://127.0.0.1:54321
# copy from `pnpm db:status`
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket, created by supabase/config.toml.
STORAGE_RESUMES_BUCKET=resumes

# Apify API token for the job collectors (LinkedIn and Google discovery).
# Optional: the API boots without it, and collection fails until it is set.
# APIFY_TOKEN=

# Prisma 8 runtime connection: the Supabase CLI's local Postgres. For hosted
# Supabase use the session pooler URL (port 5432), never the transaction pooler (6543):
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional separate connection for the Prisma CLI (migrations); defaults to DATABASE_URL.
# DIRECT_DATABASE_URL=
DATABASE_CONNECTION_TIMEOUT_MS=20000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_SLOW_QUERY_MS=500
DATABASE_LOG_QUERIES=false
