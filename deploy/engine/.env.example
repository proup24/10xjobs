# Copy to /home/deploy/engine/.env on the server (mode 600). Names only; never commit values.

# Public hostname Caddy serves and gets a certificate for.
ENGINE_HOSTNAME=
# Supabase session pooler URL, port 5432 (never 6543).
DATABASE_URL=
# Supabase project URL.
SUPABASE_URL=
# Supabase service role key.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret the web app sends as X-Engine-Key, at least 32 characters (openssl rand -base64 48).
ENGINE_API_KEY=
# Public origin of the web app, for links in webhook payloads (e.g. https://app.example.com). Optional: without it payloads carry `links.match: null`.
WEB_APP_URL=
# Apify API token for LinkedIn collection.
APIFY_TOKEN=
# Trial LinkedIn actors that collect, comma-separated channel values (LINKEDIN_JOB_BOARD_CHEAP, the cheap_scraper trial, and LINKEDIN_JOB_BOARD_BEBITY, the bebity trial). Empty or unset: none run. Runbook section 8a.
# COLLECTION_TRIAL_CHANNELS=LINKEDIN_JOB_BOARD_CHEAP,LINKEDIN_JOB_BOARD_BEBITY
# Daily Apify spend cap in dollars for the cheap_scraper trial (Morocco day), apart from harvestapi's COLLECTION_DAILY_BUDGET_USD (both default 3).
# COLLECTION_DAILY_BUDGET_USD_LINKEDIN_JOB_BOARD_CHEAP=3
# Daily Apify spend cap in dollars for the bebity trial (Morocco day), its own like the cheap_scraper one (default 1).
# COLLECTION_DAILY_BUDGET_USD_LINKEDIN_JOB_BOARD_BEBITY=1
# Daily Apify spend cap in dollars for LinkedIn posts collection (Morocco day), apart from the job board's (default 1.5). Runbook section 8b.
# COLLECTION_DAILY_BUDGET_USD_LINKEDIN_POSTS=1.5
# Comma-separated Supabase user ids who may open the admin pages (default empty: nobody).
# ADMIN_USERS=
# Claude Code OAuth token for the processor (from `claude setup-token`, valid one year; worker only, the API container drops it).
CLAUDE_CODE_OAUTH_TOKEN=
# Anthropic API key instead of the token. Required before any other person gets an account (runbook section 17).
# ANTHROPIC_API_KEY=
# Stop the processor at this share of any weekly limit (default 0.85).
# PROCESSOR_WEEKLY_STOP_AT=0.85
