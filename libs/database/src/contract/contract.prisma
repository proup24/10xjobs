// One completed extraction run for a job. Append-only; typed columns are copies
// of the validated document in data, kept for filtering. Shared, not workspace-scoped.
model JobExtraction {
  id                        Uuid                 @id @onCreate(uuid(7))
  jobId                     Uuid
  job                       NormalizedJob        @relation("JobExtractions", fields: [jobId], references: [id], onDelete: Restrict)
  inputHash                 String
  schemaVersion             Int
  promptHash                String
  decisionModel             String?
  extractionModel           String
  data                      Jsonb
  needsReview               Boolean
  arrangement               String?
  arrangementTerm           ArrangementTerm?     @relation(fields: [arrangement], references: [code], onDelete: Restrict)
  seniority                 String?
  seniorityTerm             SeniorityTerm?       @relation(fields: [seniority], references: [code], onDelete: Restrict)
  roleKind                  String?
  roleKindTerm              RoleKind?            @relation(fields: [roleKind], references: [code], onDelete: Restrict)
  contractType              String?
  contractTypeTerm          ContractType?        @relation(fields: [contractType], references: [code], onDelete: Restrict)
  engagement                String?
  engagementTerm            EngagementTerm?      @relation(fields: [engagement], references: [code], onDelete: Restrict)
  isSoftwareEngineeringRole Boolean?
  worldwide                 Boolean
  regionCodes               String[]
  countryCodes              String[]
  cityIds                   Uuid[]
  techTags                  String[]
  mainStackTags             String[]
  requiredTags              String[]             @default([])
  niceTags                  String[]             @default([])
  salaryMin                 Int?
  salaryMax                 Int?
  salaryCurrency            String?
  salaryPeriod              String?
  costUsd                   Decimal
  createdAt                 TimestamptzJsDate(3) @default(now())
  currentFor                NormalizedJob[]      @relation("CurrentExtraction")
  matches                   JobMatch[]
  attempts                  ProcessingAttempt[]
  facts                     JobFacts[]
  factConflicts             JobFactConflict[]
  factReports               FactReport[]

  @@index([jobId, createdAt], map: "job_extractions_job_created")
  @@index([inputHash, schemaVersion, promptHash, extractionModel], map: "job_extractions_reuse")
  @@index([arrangement])
  @@index([seniority])
  @@index([roleKind])
  @@index([regionCodes], type: "gin", name: "job_extractions_regionCodes_gin")
  @@index([countryCodes], type: "gin", name: "job_extractions_countryCodes_gin")
  @@index([cityIds], type: "gin", name: "job_extractions_cityIds_gin")
  @@index([techTags], type: "gin", name: "job_extractions_techTags_gin")
  @@index([mainStackTags], type: "gin", name: "job_extractions_mainStackTags_gin")
  @@index([requiredTags], type: "gin", name: "job_extractions_requiredTags_gin")
  @@index([niceTags], type: "gin", name: "job_extractions_niceTags_gin")
  @@map("job_extractions")
  @@rls
}

