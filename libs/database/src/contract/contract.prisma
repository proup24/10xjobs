// use prisma-8
//
// Data contract for xjobs. After editing, run
// `pnpm --filter @xjobs/database db:emit` to regenerate contract.json /
// contract.d.ts, then
// `pnpm --filter @xjobs/database db:migration:plan --name <slug>`.

// `JsDate` columns read and write JavaScript `Date` values; the `Temporal`
// variants need a global `Temporal`, which Node 24 does not ship.
model mixin Timestamps {
  createdAt TimestamptzJsDate(3) @default(now())
  updatedAt TimestamptzJsDate(3) @default(now()) @onCreate(now()) @onUpdate(now())
}

// Each enum below has a TypeScript twin in libs/database/src/enums/<name>.enum.ts;
// libs/database/src/enums/enums.spec.ts fails when they drift.
// Engagement backs no column any more (profiles.engagements holds engagements
// codes as text); it stays because the spec deletes only the four copied enums.
enum Engagement {
  @@type("pg/text@1")
  employee = "employee"
  contractor = "contractor"
  eor = "eor"
  agency = "agency"
  per_task = "per_task"
}

enum Arrangement {
  @@type("pg/text@1")
  remote = "remote"
  hybrid = "hybrid"
  onsite = "onsite"
  unstated = "unstated"
}

enum Seniority {
  @@type("pg/text@1")
  junior = "junior"
  mid = "mid"
  senior = "senior"
  staff = "staff"
  lead = "lead"
  principal = "principal"
  unstated = "unstated"
}

enum ContactKind {
  @@type("pg/text@1")
  phone = "phone"
  email = "email"
  linkedin = "linkedin"
  github = "github"
  gitlab = "gitlab"
  portfolio = "portfolio"
  website = "website"
  other = "other"
}

enum SkillDomain {
  @@type("pg/text@1")
  backend = "backend"
  frontend = "frontend"
  fullstack = "fullstack"
  mobile = "mobile"
  devops = "devops"
  data = "data"
  ml = "ml"
  security = "security"
  qa = "qa"
}

enum Channel {
  @@type("pg/text@1")
  LINKEDIN_JOB_BOARD = "LINKEDIN_JOB_BOARD"
  LINKEDIN_POSTS = "LINKEDIN_POSTS"
  GREEN_HOUSE = "GREEN_HOUSE"
  ASHBY = "ASHBY"
}

enum ProfileState {
  @@type("pg/text@1")
  draft = "draft"
  published = "published"
}

// Postal address; `country` is ISO 3166-1 alpha-2.
type Address {
  line1      String
  line2      String?
  city       String
  postalCode String?
  state      String?
  country    String
}

// ISO 639-1 languages and ISO 4217 currencies, seeded; reference data for profile preferences.
model IsoLanguage {
  code  String @id
  label String

  @@map("iso_languages")
  @@rls
}

model IsoCurrency {
  code  String @id
  label String

  @@map("iso_currencies")
  @@rls
}

// One row per Supabase Auth user, created by the on_auth_user_created trigger.
// The email lives only in Auth.
model User {
  id                 Uuid                   @id
  authUser           supabase:auth.AuthUser @relation(fields: [id], references: [id], onDelete: Cascade)
  name               String?
  address            Address?
  // ISO 3166-1 alpha-2 code from countries; null until the user answers.
  residenceCountry   String?
  acceptsSponsorship Boolean?
  jobMatches         JobMatch[]
  +Timestamps

  @@map("users")
  @@rls
}

// Users read and update only their own row. No insert (the sign-up trigger does it) and
// no delete (removing the Auth user cascades).
policy_select users_owner_read {
  target = User
  roles = [authenticated]
  using = sql`id = auth.uid()`
}

policy_update users_owner_update {
  target = User
  roles = [authenticated]
  using = sql`id = auth.uid()`
  withCheck = sql`id = auth.uid()`
}

// The user's own contact channels, the ones that go on applications.
model Contact {
  id        Uuid        @id @onCreate(uuid(7))
  userId    Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ContactKind
  value     String
  label     String?
  isPrimary Boolean     @default(false)
  +Timestamps

  @@unique([userId, kind, value])
  @@index([userId])
  @@map("contacts")
  @@rls
}

policy_all contacts_owner {
  target = Contact
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
  withCheck = sql`"userId" = auth.uid()`
}

// Where the user may work, and on what basis. A place is a country or region code.
model WorkAuthorization {
  id     Uuid   @id @onCreate(uuid(7))
  userId Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   String
  place  String
  +Timestamps

  @@check(expression: sql`kind IN ('work-permit','citizenship','residency','clearance')`, name: "work_authorizations_kind")
  @@unique([userId, kind, place])
  @@index([userId])
  @@map("work_authorizations")
  @@rls
}

policy_all work_authorizations_owner {
  target = WorkAuthorization
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
  withCheck = sql`"userId" = auth.uid()`
}

// A user may maintain multiple independent job-seeker profiles, one per target position.
// Timezone offsets are minutes from UTC.
model Profile {
  id                 Uuid                  @id @onCreate(uuid(7))
  userId             Uuid
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // A role_kinds code (approved, engineering); checked by the profiles_check_codes trigger.
  position           String
  yearsOfExperience  Int
  timezoneCurrent    Int
  timezoneMin        Int
  timezoneMax        Int
  // engagements and seniorities codes; `unstated` is refused by the trigger.
  engagements        String[]
  seniorities        String[]
  noticePeriodDays   Int
  // Codes from contract_types.
  contractTypes      String[]
  // { remote, hybrid, onsite } arrays of { kind: worldwide | region | country | city } places.
  locations          Jsonb
  // [{ lang: ISO 639-1 code, level: native | fluent | working }].
  languages          Jsonb
  // Minimum salary: all three set, or none.
  salaryMin          Int?
  salaryCurrency     String?
  salaryPeriod       String?
  // Either any currency, or a non-empty list of ISO 4217 codes.
  acceptsAnyCurrency Boolean               @default(true)
  acceptedCurrencies String[]              @default([])
  resumeKey          String?
  resumeFilename     String?
  resumeSizeBytes    Int?
  resumeSha256       String?
  resumeUploadedAt   TimestamptzJsDate(3)?
  state              ProfileState          @default(draft)
  publishedAt        TimestamptzJsDate(3)?
  jobMatches         JobMatch[]
  +Timestamps

  @@check(expression: sql`"yearsOfExperience" BETWEEN 0 AND 60`, name: "profiles_years_range")
  @@check(expression: sql`"noticePeriodDays" BETWEEN 0 AND 365`, name: "profiles_notice_range")
  @@check(expression: sql`"timezoneCurrent" BETWEEN -720 AND 840 AND "timezoneMin" BETWEEN -720 AND 840 AND "timezoneMax" BETWEEN -720 AND 840 AND "timezoneMin" <= "timezoneMax"`, name: "profiles_tz_range")
  @@check(expression: sql`cardinality("engagements") > 0`, name: "profiles_engagements_nonempty")
  @@check(expression: sql`cardinality("seniorities") > 0`, name: "profiles_seniorities_nonempty")
  @@check(expression: sql`("salaryMin" IS NULL) = ("salaryCurrency" IS NULL) AND ("salaryMin" IS NULL) = ("salaryPeriod" IS NULL)`, name: "profiles_salary_all_or_none")
  @@check(expression: sql`"salaryMin" > 0`, name: "profiles_salary_min_positive")
  @@check(expression: sql`"salaryPeriod" IN ('hour','day','month','year')`, name: "profiles_salary_period")
  @@check(expression: sql`("acceptsAnyCurrency" AND cardinality("acceptedCurrencies") = 0) OR (NOT "acceptsAnyCurrency" AND cardinality("acceptedCurrencies") > 0)`, name: "profiles_currencies_any_xor_list")
  @@check(expression: sql`cardinality("contractTypes") > 0`, name: "profiles_contract_types_nonempty")
  // At least one place overall; the profiles_check_codes trigger checks the shape first.
  @@check(expression: sql`jsonb_path_exists("locations", '$.*[*]')`, name: "profiles_locations_nonempty")
  // The BEFORE trigger (assert_languages) refuses a non-array first, so this only adds the non-empty rule.
  @@check(expression: sql`jsonb_typeof("languages") = 'array' AND jsonb_array_length("languages") > 0`, name: "profiles_languages_nonempty")
  // Value-list codes are checked by the profiles_check_codes trigger (assert_codes, assert_places, assert_languages).
  // Target of profile_skills' (profileId, userId) foreign key.
  @@unique([id, userId])
  @@index([userId])
  @@map("profiles")
  @@rls
}

// One row per technology and domain in a profile's tech stack.
// userId always equals the profile's userId: the (profileId, userId) foreign key enforces it.
model ProfileSkill {
  id         Uuid        @id @onCreate(uuid(7))
  userId     Uuid
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId  Uuid
  profile    Profile     @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
  // A tech_tags code; checked by the profile_skills_check_codes trigger.
  technology String
  domain     SkillDomain
  mastery    Int
  importance Int         @default(5)
  +Timestamps

  @@check(expression: sql`mastery BETWEEN 0 AND 10`, name: "profile_skills_mastery_range")
  @@check(expression: sql`importance BETWEEN 0 AND 10`, name: "profile_skills_importance_range")
  @@unique([profileId, technology, domain])
  @@index([userId])
  @@map("profile_skills")
  @@rls
}

// Owners read their profiles at any state but create, edit and delete only drafts. The
// engine publishes: state and publishedAt are not writable by users (column grants too).
policy_select profiles_owner_read {
  target = Profile
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
}

policy_insert profiles_owner_insert {
  target = Profile
  roles = [authenticated]
  withCheck = sql`"userId" = auth.uid() AND state = 'draft' AND "publishedAt" IS NULL`
}

policy_update profiles_owner_update_draft {
  target = Profile
  roles = [authenticated]
  using = sql`"userId" = auth.uid() AND state = 'draft'`
  withCheck = sql`"userId" = auth.uid() AND state = 'draft' AND "publishedAt" IS NULL`
}

policy_delete profiles_owner_delete_draft {
  target = Profile
  roles = [authenticated]
  using = sql`"userId" = auth.uid() AND state = 'draft'`
}

// Skills follow their profile: writable only while the user's own profile is a draft.
// The outer column is qualified; a bare "userId" in the subquery would resolve to p."userId".
policy_select profile_skills_owner_read {
  target = ProfileSkill
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
}

policy_insert profile_skills_owner_insert {
  target = ProfileSkill
  roles = [authenticated]
  withCheck = sql`"userId" = auth.uid() AND EXISTS (SELECT 1 FROM public.profiles p WHERE p.id = profile_skills."profileId" AND p."userId" = auth.uid() AND p.state = 'draft')`
}

policy_update profile_skills_owner_update {
  target = ProfileSkill
  roles = [authenticated]
  using = sql`"userId" = auth.uid() AND EXISTS (SELECT 1 FROM public.profiles p WHERE p.id = profile_skills."profileId" AND p."userId" = auth.uid() AND p.state = 'draft')`
  withCheck = sql`"userId" = auth.uid() AND EXISTS (SELECT 1 FROM public.profiles p WHERE p.id = profile_skills."profileId" AND p."userId" = auth.uid() AND p.state = 'draft')`
}

policy_delete profile_skills_owner_delete {
  target = ProfileSkill
  roles = [authenticated]
  using = sql`"userId" = auth.uid() AND EXISTS (SELECT 1 FROM public.profiles p WHERE p.id = profile_skills."profileId" AND p."userId" = auth.uid() AND p.state = 'draft')`
}

// Answers to setup steps 3–4 until the profile can be created; one per user.
model ProfileSetupDraft {
  id      Uuid  @id @onCreate(uuid(7))
  userId  Uuid  @unique
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers Jsonb
  +Timestamps

  @@map("profile_setup_drafts")
  @@rls
}

policy_all profile_setup_drafts_owner {
  target = ProfileSetupDraft
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
  withCheck = sql`"userId" = auth.uid()`
}

// A shared, immutable search recipe for one channel, deduplicated by hash across every
// profile. Profiles use it through ProfileQuerySearchBuilder; rows are never hard-deleted,
// because raw job hits are attributed to them.
model QuerySearchBuilder {
  id                 Uuid                  @id @onCreate(uuid(7))
  channel            Channel
  // Canonical (lowercased) location text the channels search.
  location           String
  experience         Seniority
  // tech_tags codes. Only the engine writes this table, so no trigger checks them.
  technologies       String[]
  // The skill domain the technologies came from; part of the hash.
  domain             SkillDomain
  type               Arrangement
  keyword            String
  version            Int
  params             Jsonb
  hash               String
  // Number of ProfileQuerySearchBuilder rows; kept in step under a row lock.
  associatedProfiles Int                   @default(0)
  // Collected only while active: at least one published profile uses it.
  isActive           Boolean               @default(false)
  // Soft delete: retired recipes are never collected, linked or listed again.
  isDeleted          Boolean               @default(false)
  // Collection cursor: everything posted before this was searched. Null until first collected.
  coveredUntil       TimestamptzJsDate(3)?
  // Collection claim: the segment run collecting this query now, its interval and lease. All null when unclaimed.
  claimRunId         Uuid?
  claimWindowStart   TimestamptzJsDate(3)?
  claimWindowEnd     TimestamptzJsDate(3)?
  claimExpiresAt     TimestamptzJsDate(3)?
  +Timestamps

  @@check(expression: sql`"associatedProfiles" >= 0`, name: "query_search_builder_associated_profiles")
  @@check(expression: sql`("claimRunId" IS NULL) = ("claimWindowStart" IS NULL) AND ("claimRunId" IS NULL) = ("claimWindowEnd" IS NULL) AND ("claimRunId" IS NULL) = ("claimExpiresAt" IS NULL)`, name: "query_search_builder_claim_complete")
  @@check(expression: sql`NOT ("isDeleted" AND "isActive")`, name: "query_search_builder_deleted_inactive")
  @@unique([hash])
  @@index([channel, isActive, isDeleted])
  @@map("query_search_builder")
  @@rls
}

// Which published profiles use which shared query search builder.
model ProfileQuerySearchBuilder {
  id        Uuid                 @id @onCreate(uuid(7))
  profileId Uuid
  profile   Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  queryId   Uuid
  query     QuerySearchBuilder   @relation(fields: [queryId], references: [id], onDelete: Cascade)
  createdAt TimestamptzJsDate(3) @default(now())

  @@unique([profileId, queryId])
  @@index([queryId])
  @@map("profile_query_search_builders")
  @@rls
}

// One Apify run over one search segment: up to 10 builders of a channel sharing
// domain, arrangement and place. Segments are recomputed per run, saved only here.
model SearchSegmentRun {
  id                Uuid                 @id @onCreate(uuid(7))
  channel           Channel
  segmentKey        String
  segmentHash       String
  queryIds          Uuid[]
  windowStart       TimestamptzJsDate(3)
  windowEnd         TimestamptzJsDate(3)
  startedAt         TimestamptzJsDate(3)
  finishedAt        TimestamptzJsDate(3)
  status            String
  fetched           Int
  costMicroUsd      Int?
  capped            Boolean
  truncatedQueryIds Uuid[]
  perQuery          Jsonb
  // What the source said matched each search (LinkedIn's SEARCH_TOTALS), untouched.
  searchTotals      Jsonb?
  error             String?

  @@check(expression: sql`status IN ('succeeded', 'partial', 'failed')`, name: "search_segment_runs_status")
  @@check(expression: sql`"windowStart" < "windowEnd"`, name: "search_segment_runs_window")
  @@index([channel, startedAt])
  @@map("search_segment_runs")
  @@rls
}

// One segment run's untouched results, stored as a file; ingest consumes it.
// The row is the source of truth for whether it was ingested.
model CollectionBatch {
  id            Uuid                  @id @onCreate(uuid(7))
  channel       Channel
  segmentRunId  Uuid                  @unique
  segmentRun    SearchSegmentRun      @relation(fields: [segmentRunId], references: [id], onDelete: Restrict)
  storageKey    String
  formatVersion Int
  observedAt    TimestamptzJsDate(3)
  itemCount     Int
  actor         String
  apifyRunId    String?
  status        String
  attempts      Int                   @default(0)
  lastError     String?
  ingestedAt    TimestamptzJsDate(3)?
  report        Jsonb?
  createdAt     TimestamptzJsDate(3)  @default(now())

  @@check(expression: sql`status IN ('pending', 'ingested', 'failed')`, name: "collection_batches_status")
  @@check(expression: sql`attempts >= 0`, name: "collection_batches_attempts")
  @@index([status, createdAt])
  @@map("collection_batches")
  @@rls
}

// One source posting or post per channel, identified by its source key. Shared, not workspace-scoped.
model RawItem {
  id              Uuid                 @id @onCreate(uuid(7))
  channel         Channel
  sourceKey       String
  kind            String
  firstSeenAt     TimestamptzJsDate(3)
  lastSeenAt      TimestamptzJsDate(3)
  // The version with the greatest lastSeenAt; no FK, to avoid a cycle with versions.
  latestVersionId Uuid?

  @@check(expression: sql`kind IN ('job', 'post')`, name: "raw_items_kind")
  @@check(expression: sql`"firstSeenAt" <= "lastSeenAt"`, name: "raw_items_seen_order")
  @@unique([channel, sourceKey])
  @@map("raw_items")
  @@rls
}

// One distinct content of a raw item, untouched. Append-only: Process consumes these.
model RawItemVersion {
  id           Uuid                 @id @onCreate(uuid(7))
  rawItemId    Uuid
  rawItem      RawItem              @relation(fields: [rawItemId], references: [id], onDelete: Cascade)
  contentHash  String
  payload      Jsonb
  firstBatchId Uuid
  firstBatch   CollectionBatch      @relation(fields: [firstBatchId], references: [id], onDelete: Restrict)
  firstSeenAt  TimestamptzJsDate(3)
  lastSeenAt   TimestamptzJsDate(3)
  createdAt    TimestamptzJsDate(3) @default(now())

  @@check(expression: sql`"firstSeenAt" <= "lastSeenAt"`, name: "raw_item_versions_seen_order")
  @@unique([rawItemId, contentHash])
  @@index([createdAt])
  @@map("raw_item_versions")
  @@rls
}

// Which query saw which raw item in which batch. `attribution` is the query id, or
// 'none' for an item no member query claimed, so uniqueness also holds for those.
model RawItemSighting {
  id          Uuid                 @id @onCreate(uuid(7))
  batchId     Uuid
  batch       CollectionBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  rawItemId   Uuid
  rawItem     RawItem              @relation(fields: [rawItemId], references: [id], onDelete: Cascade)
  versionId   Uuid
  version     RawItemVersion       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  queryId     Uuid?
  attribution String
  query       QuerySearchBuilder?  @relation(fields: [queryId], references: [id], onDelete: Restrict)
  rank        Int?
  observedAt  TimestamptzJsDate(3)

  @@check(expression: sql`rank IS NULL OR rank > 0`, name: "raw_item_sightings_rank")
  @@check(expression: sql`attribution = COALESCE("queryId"::text, 'none')`, name: "raw_item_sightings_attribution")
  @@unique([batchId, rawItemId, attribution])
  @@index([rawItemId])
  @@map("raw_item_sightings")
  @@rls
}

// One raw version mapped to the unified job format by a given normalizer version.
// Deterministic: rebuilt from the raw version whenever the normalizer changes.
model NormalizedVersion {
  id                Uuid                 @id @onCreate(uuid(7))
  rawVersionId      Uuid
  rawVersion        RawItemVersion       @relation(fields: [rawVersionId], references: [id], onDelete: Cascade)
  normalizerVersion Int
  status            String
  reason            String?
  record            Jsonb?
  jobKey            String?
  createdAt         TimestamptzJsDate(3) @default(now())

  @@check(expression: sql`status IN ('valid', 'invalid')`, name: "normalized_versions_status")
  @@check(expression: sql`(status = 'valid') = (record IS NOT NULL AND "jobKey" IS NOT NULL)`, name: "normalized_versions_valid_record")
  @@unique([rawVersionId, normalizerVersion])
  @@map("normalized_versions")
  @@rls
}

// One job, unified from every raw item whose job key (its canonical apply URL)
// matches. Fields are merged with the employer's ATS posting winning. Process
// reads these rows; ingest only ever sets processingStatus to 'pending'.
// Shared, not workspace-scoped, like the raw tables it is derived from.
model NormalizedJob {
  id                    Uuid                  @id @onCreate(uuid(7))
  jobKey                String
  kind                  String
  status                String
  // Set when the job lost its last source to another job; never deleted.
  mergedIntoId          Uuid?
  mergedInto            NormalizedJob?        @relation(fields: [mergedIntoId], references: [id], onDelete: Restrict)
  title                 String?
  companyName           String?
  companyUrl            String?
  location              String?
  contractType          String?
  experienceLevel       String?
  sector                String?
  salaryText            String?
  // Whole currency units.
  salaryMin             Int?
  salaryMax             Int?
  salaryCurrency        String?
  salaryPeriod          String?
  // YYYY-MM-DD.
  publishedAt           String?
  descriptionHtml       String?
  descriptionText       String?
  applyUrl              String?
  postingUrl            String
  posterName            String?
  posterProfileUrl      String?
  posterType            String?
  closed                Boolean
  // Which raw item each field came from.
  fieldSources          Jsonb
  firstSeenAt           TimestamptzJsDate(3)
  lastSeenAt            TimestamptzJsDate(3)
  processingStatus      String?
  processingReason      String?
  processingRequestedAt TimestamptzJsDate(3)?
  processingAttempts    Int                   @default(0)
  processingError       String?
  processedAt           TimestamptzJsDate(3)?
  // The extraction qualify reads; set by the processor.
  currentExtractionId   Uuid?
  currentExtraction     JobExtraction?        @relation("CurrentExtraction", fields: [currentExtractionId], references: [id], onDelete: SetNull)
  // Claim time while processingStatus is 'processing'; the sweeper reads it.
  processingStartedAt   TimestamptzJsDate(3)?
  normalizerVersion     Int
  extractions           JobExtraction[]       @relation("JobExtractions")
  attempts              ProcessingAttempt[]
  matches               JobMatch[]
  +Timestamps

  @@check(expression: sql`kind IN ('job', 'post')`, name: "normalized_jobs_kind")
  @@check(expression: sql`status IN ('active', 'merged')`, name: "normalized_jobs_status")
  @@check(expression: sql`(status = 'merged') = ("mergedIntoId" IS NOT NULL)`, name: "normalized_jobs_merged_into")
  @@check(expression: sql`"processingStatus" IS NULL OR "processingStatus" IN ('pending', 'processing', 'processed', 'failed')`, name: "normalized_jobs_processing_status")
  @@check(expression: sql`"processingReason" IS NULL OR "processingReason" IN ('new', 'reopened')`, name: "normalized_jobs_processing_reason")
  @@check(expression: sql`"processingAttempts" >= 0`, name: "normalized_jobs_processing_attempts")
  @@check(expression: sql`"firstSeenAt" <= "lastSeenAt"`, name: "normalized_jobs_seen_order")
  @@unique([jobKey])
  @@index([processingStatus, processingRequestedAt], map: "normalized_jobs_processing_queue")
  @@map("normalized_jobs")
  @@rls
}

// Which job a raw item belongs to (exactly one), decided by its latest version.
model NormalizedJobSource {
  id                  Uuid                 @id @onCreate(uuid(7))
  jobId               Uuid
  job                 NormalizedJob        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  rawItemId           Uuid
  rawItem             RawItem              @relation(fields: [rawItemId], references: [id], onDelete: Cascade)
  normalizedVersionId Uuid
  normalizedVersion   NormalizedVersion    @relation(fields: [normalizedVersionId], references: [id], onDelete: Cascade)
  linkedAt            TimestamptzJsDate(3)

  @@unique([rawItemId])
  @@index([jobId])
  @@map("normalized_job_sources")
  @@rls
}

// TechTag list: a closed vocabulary of codes; unknown terms enter as 'proposed'.
model TechTag {
  code        String                @id
  label       String
  aliases     String[]
  status      String
  occurrences Int                   @default(0)
  firstSeenAt TimestamptzJsDate(3)
  approvedAt  TimestamptzJsDate(3)?
  family      String?
  implies     String[]

  @@check(expression: sql`status IN ('approved', 'proposed')`, name: "tech_tags_status")
  @@map("tech_tags")
  @@rls
}

// RegionTerm list: a closed vocabulary of codes; unknown terms enter as 'proposed'.
model RegionTerm {
  code        String                @id
  label       String
  aliases     String[]
  status      String
  occurrences Int                   @default(0)
  firstSeenAt TimestamptzJsDate(3)
  approvedAt  TimestamptzJsDate(3)?
  countries   RegionCountry[]

  @@check(expression: sql`status IN ('approved', 'proposed')`, name: "regions_status")
  @@map("regions")
  @@rls
}

