// Which countries a region contains; lets a country filter match "EMEA remote" jobs.
model RegionCountry {
  regionCode  String
  region      RegionTerm @relation(fields: [regionCode], references: [code], onDelete: Cascade)
  countryCode String
  country     Country    @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@id([regionCode, countryCode])
  @@index([countryCode])
  @@map("region_countries")
  @@rls
}

// A city named by postings; created as they appear, not pre-seeded. Unique per
// country by lower-cased name (nameKey), because the contract has no functional index.
model City {
  id          Uuid                  @id @onCreate(uuid(7))
  name        String
  nameKey     String
  countryCode String
  country     Country               @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  geonamesId  Int?
  aliases     String[]
  status      String
  occurrences Int                   @default(0)
  firstSeenAt TimestamptzJsDate(3)
  approvedAt  TimestamptzJsDate(3)?

  @@check(expression: sql`status IN ('approved', 'proposed')`, name: "cities_status")
  @@unique([nameKey, countryCode])
  @@map("cities")
  @@rls
}

// One completed extraction run for a job. Append-only; typed columns are copies
// of the validated document in data, kept for filtering. Shared, not workspace-scoped.
model JobExtraction {
  id                        Uuid                 @id @onCreate(uuid(7))
  jobId                     Uuid
  job                       NormalizedJob        @relation("JobExtractions", fields: [jobId], references: [id], onDelete: Restrict)
  inputHash                 String
  schemaVersion             Int
  promptHash                String
  decisionModel             String
  extractionModel           String
  data                      Jsonb
  needsReview               Boolean
  arrangement               String?
  arrangementTerm           ArrangementTerm?     @relation(fields: [arrangement], references: [code], onDelete: Restrict)
  seniority                 String?
  seniorityTerm             SeniorityTerm?       @relation(fields: [seniority], references: [code], onDelete: Restrict)
  roleKind                  String?
  roleKindTerm              RoleKind?            @relation(fields: [roleKind], references: [code], onDelete: Restrict)
  contractType              String?
  contractTypeTerm          ContractType?        @relation(fields: [contractType], references: [code], onDelete: Restrict)
  engagement                String?
  engagementTerm            EngagementTerm?      @relation(fields: [engagement], references: [code], onDelete: Restrict)
  isSoftwareEngineeringRole Boolean?
  worldwide                 Boolean
  regionCodes               String[]
  countryCodes              String[]
  cityIds                   Uuid[]
  techTags                  String[]
  mainStackTags             String[]
  requiredTags              String[]             @default([])
  niceTags                  String[]             @default([])
  salaryMin                 Int?
  salaryMax                 Int?
  salaryCurrency            String?
  salaryPeriod              String?
  costUsd                   Decimal
  createdAt                 TimestamptzJsDate(3) @default(now())
  currentFor                NormalizedJob[]      @relation("CurrentExtraction")
  matches                   JobMatch[]
  attempts                  ProcessingAttempt[]

  @@index([jobId, createdAt], map: "job_extractions_job_created")
  @@index([inputHash, schemaVersion, promptHash, decisionModel, extractionModel], map: "job_extractions_reuse")
  @@index([arrangement])
  @@index([seniority])
  @@index([roleKind])
  @@index([regionCodes], type: "gin", name: "job_extractions_regionCodes_gin")
  @@index([countryCodes], type: "gin", name: "job_extractions_countryCodes_gin")
  @@index([cityIds], type: "gin", name: "job_extractions_cityIds_gin")
  @@index([techTags], type: "gin", name: "job_extractions_techTags_gin")
  @@index([mainStackTags], type: "gin", name: "job_extractions_mainStackTags_gin")
  @@index([requiredTags], type: "gin", name: "job_extractions_requiredTags_gin")
  @@index([niceTags], type: "gin", name: "job_extractions_niceTags_gin")
  @@map("job_extractions")
  @@rls
}

// One model call made while processing a job. Append-only; feeds the daily budget.
// jobId is null for golden-set eval rows.
model ProcessingAttempt {
  id                Uuid                 @id @onCreate(uuid(7))
  jobId             Uuid?
  job               NormalizedJob?       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  extractionId      Uuid?
  extraction        JobExtraction?       @relation(fields: [extractionId], references: [id], onDelete: SetNull)
  eval              Boolean              @default(false)
  step              String
  model             String
  providerRequestId String?
  inputTokens       Int
  outputTokens      Int
  cachedInputTokens Int
  costUsd           Decimal
  latencyMs         Int
  outcome           String
  error             String?
  quoteFailures     Int                  @default(0)
  createdAt         TimestamptzJsDate(3) @default(now())

  @@check(expression: sql`step IN ('decision', 'extraction', 'extraction_retry', 'generation', 'generation_retry', 'verification')`, name: "processing_attempts_step")
  @@check(expression: sql`outcome IN ('ok', 'error', 'invalid')`, name: "processing_attempts_outcome")
  @@index([createdAt], where: sql`NOT eval`, name: "processing_attempts_created_noneval")
  @@map("processing_attempts")
  @@rls
}

// The engine's qualify verdict for one published profile and one job. Users read; only the
// engine writes. extractionId records which extraction the verdict was made on.
model JobMatch {
  id             Uuid                 @id @onCreate(uuid(7))
  userId         Uuid
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId      Uuid
  profile        Profile              @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
  jobId          Uuid
  job            NormalizedJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  extractionId   Uuid
  extraction     JobExtraction        @relation(fields: [extractionId], references: [id], onDelete: Restrict)
  matcherVersion Int
  outcome        String
  unverified     Boolean
  stackScore     Numeric(4, 3)?
  checks         Jsonb
  decidedAt      TimestamptzJsDate(3)
  +Timestamps

  @@check(expression: sql`outcome IN ('qualified','rejected')`, name: "job_matches_outcome")
  @@check(expression: sql`"stackScore" IS NULL OR "stackScore" BETWEEN 0 AND 1`, name: "job_matches_stack_score_range")
  @@check(expression: sql`NOT (outcome = 'rejected' AND unverified)`, name: "job_matches_rejected_verified")
  @@unique([profileId, jobId])
  @@index([profileId, outcome, decidedAt])
  @@index([jobId])
  @@map("job_matches")
  @@rls
}

// Owners read their matches. Only the engine writes them.
policy_select job_matches_owner_read {
  target = JobMatch
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
}

