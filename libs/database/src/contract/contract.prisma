// Where the listing and the description disagreed on a field, and which one won.
// Replaced as a set with the job's facts row. Engine-only.
model JobFactConflict {
  id               Uuid                 @id @onCreate(uuid(7))
  jobId            Uuid
  job              NormalizedJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  extractionId     Uuid
  extraction       JobExtraction        @relation(fields: [extractionId], references: [id], onDelete: Restrict)
  field            String
  listingValue     Jsonb
  descriptionValue Jsonb
  quote            String
  winner           String
  createdAt        TimestamptzJsDate(3) @default(now())

  @@check(expression: sql`winner IN ('description','listing')`, name: "job_fact_conflicts_winner")
  @@index([jobId])
  @@index([field])
  @@map("job_fact_conflicts")
  @@rls
}

// One model call made while processing a job. Append-only; feeds the daily budget.
// jobId is null for golden-set eval rows.
model ProcessingAttempt {
  id                Uuid                 @id @onCreate(uuid(7))
  jobId             Uuid?
  job               NormalizedJob?       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  extractionId      Uuid?
  extraction        JobExtraction?       @relation(fields: [extractionId], references: [id], onDelete: SetNull)
  eval              Boolean              @default(false)
  step              String
  model             String
  providerRequestId String?
  inputTokens       Int
  outputTokens      Int
  cachedInputTokens Int
  costUsd           Decimal
  latencyMs         Int
  outcome           String
  error             String?
  quoteFailures     Int                  @default(0)
  createdAt         TimestamptzJsDate(3) @default(now())

  @@check(expression: sql`step IN ('decision', 'extraction', 'extraction_retry', 'generation', 'generation_retry', 'verification')`, name: "processing_attempts_step")
  @@check(expression: sql`outcome IN ('ok', 'error', 'invalid')`, name: "processing_attempts_outcome")
  @@index([createdAt], where: sql`NOT eval`, name: "processing_attempts_created_noneval")
  @@map("processing_attempts")
  @@rls
}

// The engine's qualify verdict for one published profile and one job. Users read; only the
// engine writes. extractionId records which extraction the verdict was made on.
model JobMatch {
  id             Uuid                 @id @onCreate(uuid(7))
  userId         Uuid
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId      Uuid
  profile        Profile              @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
  jobId          Uuid
  job            NormalizedJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  extractionId   Uuid
  extraction     JobExtraction        @relation(fields: [extractionId], references: [id], onDelete: Restrict)
  // The hash of the job_facts the decision read; null on rows decided before job facts.
  factsHash      String?
  matcherVersion Int
  outcome        String
  unverified     Boolean
  // On a review: the first rule that failed only on an unsure fact, and that fact.
  reviewRule     String?
  reviewField    String?
  stackScore     Numeric(4, 3)?
  checks         Jsonb
  decidedAt      TimestamptzJsDate(3)
  // What the decision read: the profile's matchVersion and the user's eligibilityVersion.
  // A row decided before either changed is stale. Null on rows decided before they were recorded.
  profileVersion     Int?
  eligibilityVersion Int?
  reviews            MatchReview[]
  webhookDeliveries  WebhookDelivery[]
  +Timestamps

  @@check(expression: sql`outcome IN ('qualified','rejected','review')`, name: "job_matches_outcome")
  @@check(expression: sql`(outcome = 'review') = ("reviewRule" IS NOT NULL AND "reviewField" IS NOT NULL) AND ("reviewRule" IS NULL) = ("reviewField" IS NULL)`, name: "job_matches_review_reason")
  @@check(expression: sql`"stackScore" IS NULL OR "stackScore" BETWEEN 0 AND 1`, name: "job_matches_stack_score_range")
  @@check(expression: sql`NOT (outcome IN ('rejected','review') AND unverified)`, name: "job_matches_rejected_verified")
  @@unique([profileId, jobId])
  @@index([profileId, outcome, decidedAt])
  @@index([jobId])
  @@map("job_matches")
  @@rls
}

// Owners read their matches. Only the engine writes them.
policy_select job_matches_owner_read {
  target = JobMatch
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
}

// Jobs a user opened the post or apply link of; the matches view's "Viewed" mark. Written by the user, once per job.
model JobView {
  id       Uuid               @id @default(sql`gen_random_uuid()`) @onCreate(uuid(7))
  userId   Uuid
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId    Uuid
  job      NormalizedJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  viewedAt TimestamptzJsDate(3) @default(now())

  @@unique([userId, jobId])
  @@map("job_views")
  @@rls
}

// Owners read their views.
policy_select job_views_owner_read {
  target = JobView
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
}

// Owners record a view of a job they are matched with. No update or delete.
policy_insert job_views_owner_insert {
  target = JobView
  roles = [authenticated]
  withCheck = sql`"userId" = auth.uid() AND EXISTS (SELECT 1 FROM public.job_matches m WHERE m."userId" = auth.uid() AND m."jobId" = job_views."jobId")`
}

// A user's own mark on a job: applied, expired (the listing could not be applied to), or dismissed ("Not for me") with an optional reason. One per user and job; hides the job from Matches and Review. Users write it; the engine only moves it on merges.
model JobDecision {
  id            Uuid                 @id @default(sql`gen_random_uuid()`) @onCreate(uuid(7))
  userId        Uuid
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         Uuid
  job           NormalizedJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status        String
  reason        String?
  note          String?
  decidedAt     TimestamptzJsDate(3) @default(now())
  matchSnapshot Jsonb?
  +Timestamps

  @@check(expression: sql`status IN ('applied','dismissed','expired')`, name: "job_decisions_status")
  @@check(expression: sql`reason IS NULL OR reason IN ('role','seniority','location','stack','salary','contract','languages','work_authorization','company','other')`, name: "job_decisions_reason")
  @@check(expression: sql`note IS NULL OR char_length(note) <= 500`, name: "job_decisions_note_length")
  @@check(expression: sql`status = 'dismissed' OR (reason IS NULL AND note IS NULL AND "matchSnapshot" IS NULL)`, name: "job_decisions_applied_bare")
  @@unique([userId, jobId])
  @@index([jobId])
  @@map("job_decisions")
  @@rls
}

// Owners read their decisions.
policy_select job_decisions_owner_read {
  target = JobDecision
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
}

// Owners mark a job they are matched with. Later changes need no match: an applied job
// stays editable after the engine rejects it or the profile is deleted.
policy_insert job_decisions_owner_insert {
  target = JobDecision
  roles = [authenticated]
  withCheck = sql`"userId" = auth.uid() AND EXISTS (SELECT 1 FROM public.job_matches m WHERE m."userId" = auth.uid() AND m."jobId" = job_decisions."jobId")`
}

// Column grants (job-decisions-update-columns) keep the user and job fixed.
policy_update job_decisions_owner_update {
  target = JobDecision
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
  withCheck = sql`"userId" = auth.uid()`
}

policy_delete job_decisions_owner_delete {
  target = JobDecision
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
}

// A user's decision on a match in review: move it to Matches (qualified) or out (rejected).
// An overlay next to the engine's row, which it never changes. It records the rule and field
// that sent the match to review, and applies (match_details) only while the latest decision
// for the match is on the match's current reviewRule and reviewField and was made since the
// match's decidedAt: a re-decision to another outcome or another rule or field wins, and older
// rows stay as history (they don't apply again when the match returns to review).
model MatchReview {
  // Users insert through PostgREST, so the id has a database default too.
  id        Uuid     @id @default(sql`gen_random_uuid()`) @onCreate(uuid(7))
  userId    Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId Uuid
  matchId   Uuid
  match     JobMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  jobId     Uuid
  choice    String
  // The match's profileVersion when the choice was made (set by a trigger); a choice applies only
  // while the match is still on that version.
  profileVersion Int?
  rule      String
  field     String
  note      String?
  +Timestamps

  @@check(expression: sql`choice IN ('qualified','rejected')`, name: "match_reviews_choice")
  @@index([matchId, createdAt])
  @@map("match_reviews")
  @@rls
}

// Owners read their decisions.
policy_select match_reviews_owner_read {
  target = MatchReview
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
}

// Owners decide only on their own match while it is in review on the rule and field the
// decision names; profileId and jobId must be the match's. The outer columns are qualified: a
// bare name in the subquery would resolve to m.
policy_insert match_reviews_owner_insert {
  target = MatchReview
  roles = [authenticated]
  withCheck = sql`"userId" = auth.uid() AND EXISTS (SELECT 1 FROM public.job_matches m WHERE m.id = match_reviews."matchId" AND m."userId" = auth.uid() AND m."profileId" = match_reviews."profileId" AND m."jobId" = match_reviews."jobId" AND m.outcome = 'review' AND m."reviewRule" = match_reviews.rule AND m."reviewField" = match_reviews.field)`
}

// Owners delete their decisions. No update: a decision is history, a new one supersedes it.
policy_delete match_reviews_owner_delete {
  target = MatchReview
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
}

// A user's webhook: where qualified matches are POSTed. One per user. Users read it and write
// only through the webhook_* RPCs, which keep enabledSince, the secret and the failure counters
// out of their hands. Only the engine and those RPCs write it.
model Webhook {
  // The RPCs insert from SQL, so the id has a database default too.
  id                  Uuid                  @id @default(sql`gen_random_uuid()`) @onCreate(uuid(7))
  userId              Uuid
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // https only, checked on save.
  url                 String
  // 32 random bytes, base64url without padding; the receiver checks the signature with it.
  // pgcrypto's gen_random_bytes, from the extensions schema; written as Postgres prints it back.
  secret              String                @default(sql`translate(encode(gen_random_bytes(32), 'base64'::text), '+/='::text, '-_'::text)`)
  enabled             Boolean               @default(true)
  // Set on create and whenever the webhook goes from off to on: only jobs first seen since are sent.
  enabledSince        TimestamptzJsDate(3)  @default(now())
  // null, 'user' (turned off) or 'failing' (turned off by the engine after repeated failures).
  disabledReason      String?
  // Failed attempts since the last 2xx.
  consecutiveFailures Int                   @default(0)
  lastSuccessAt       TimestamptzJsDate(3)?
  lastFailureAt       TimestamptzJsDate(3)?
  deliveries          WebhookDelivery[]
  +Timestamps

  @@check(expression: sql`"disabledReason" IN ('user', 'failing')`, name: "webhooks_disabled_reason")
  @@check(expression: sql`length(url) <= 2048`, name: "webhooks_url_length")
  @@unique([userId])
  // Target of the deliveries' (webhookId, userId) key, so a delivery stays on its owner's webhook.
  @@unique([id, userId])
  @@map("webhooks")
  @@rls
}

// Owners read their webhook. No insert, update or delete policy: the RPCs write it.
policy_select webhooks_owner_read {
  target = Webhook
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
}

// One POST to a webhook, with its retries: a match (profile, job) or a test. Created by
// webhook_enqueue_match (the engine's decision, the review trigger) or webhook_send_test();
// only the engine updates it. Match rows are never deleted: the unique (profileId, jobId)
// index is the permanent "already sent" record.
model WebhookDelivery {
  id             Uuid                  @id @default(sql`gen_random_uuid()`) @onCreate(uuid(7))
  userId         Uuid
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookId      Uuid
  webhook        Webhook               @relation(fields: [webhookId, userId], references: [id, userId], onDelete: Cascade)
  // 'match' or 'test'.
  kind           String
  // Null for test rows.
  profileId      Uuid?
  profile        Profile?              @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
  jobId          Uuid?
  job            NormalizedJob?        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Null for test rows, and once the match is deleted (the matcher's sweep deletes matches of
  // jobs no longer active): the row stays as the "already sent" record.
  matchId        Uuid?
  match          JobMatch?             @relation(fields: [matchId], references: [id], onDelete: SetNull)
  // 'decision' or 'review'; null for test rows.
  trigger        String?
  // 'pending', 'sending', 'delivered', 'failed' (gave up) or 'skipped' (webhook off or gone).
  status         String                @default("pending")
  attempts       Int                   @default(0)
  nextAttemptAt  TimestamptzJsDate(3)  @default(now())
  lastStatusCode Int?
  // A short, truncated reason. The response body is never stored.
  lastError      String?
  deliveredAt    TimestamptzJsDate(3)?
  // Null until the engine builds it on the first attempt; kept so retries send the same body.
  payload        Jsonb?
  +Timestamps

  @@check(expression: sql`kind IN ('match', 'test')`, name: "webhook_deliveries_kind")
  @@check(expression: sql`trigger IN ('decision', 'review')`, name: "webhook_deliveries_trigger")
  @@check(expression: sql`status IN ('pending', 'sending', 'delivered', 'failed', 'skipped')`, name: "webhook_deliveries_status")
  @@check(expression: sql`kind <> 'match' OR ("profileId" IS NOT NULL AND "jobId" IS NOT NULL AND trigger IS NOT NULL)`, name: "webhook_deliveries_match_complete")
  @@index([profileId, jobId], where: sql`kind = 'match'`, unique: true, name: "webhook_deliveries_match_once")
  @@index([webhookId, status, createdAt])
  @@map("webhook_deliveries")
  @@rls
}

// Owners read their deliveries. Only the engine and SECURITY DEFINER functions write them.
policy_select webhook_deliveries_owner_read {
  target = WebhookDelivery
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
}

// A user's report that a fact on a job is wrong: what the processor said (value and quote),
// LinkedIn's value when there is one, and the value the user says is right. A log for
// improving the prompt and the golden set; it changes nothing. Only the engine reads them all.
model FactReport {
  // Users insert through PostgREST, so the id has a database default too.
  id             Uuid                 @id @default(sql`gen_random_uuid()`) @onCreate(uuid(7))
  userId         Uuid
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId          Uuid
  job            NormalizedJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  extractionId   Uuid?
  extraction     JobExtraction?       @relation(fields: [extractionId], references: [id], onDelete: SetNull)
  field          String
  processorValue Jsonb?
  quote          String?
  listingValue   Jsonb?
  proposedValue  String
  note           String?
  createdAt      TimestamptzJsDate(3) @default(now())

  @@index([userId])
  @@index([jobId])
  @@map("fact_reports")
  @@rls
}

// Owners read their reports.
policy_select fact_reports_owner_read {
  target = FactReport
  roles = [authenticated]
  using = sql`"userId" = auth.uid()`
}

// Owners report a fact on a job they are matched with. No update or delete.
policy_insert fact_reports_owner_insert {
  target = FactReport
  roles = [authenticated]
  withCheck = sql`"userId" = auth.uid() AND EXISTS (SELECT 1 FROM public.job_matches m WHERE m."userId" = auth.uid() AND m."jobId" = fact_reports."jobId")`
}

