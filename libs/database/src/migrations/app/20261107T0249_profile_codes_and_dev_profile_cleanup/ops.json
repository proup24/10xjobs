  {
    "id": "checkConstraint.profiles.profiles_locations_shape_c8b4dcae",
    "label": "Add check constraint \"profiles_locations_shape_c8b4dcae\" on \"profiles\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "checkConstraint",
        "name": "profiles_locations_shape_c8b4dcae",
        "table": "profiles"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"profiles_locations_shape_c8b4dcae\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "profiles_locations_shape_c8b4dcae",
          "public",
          "\"public\".\"profiles\""
        ],
        "expectation": {
          "expects": "absent",
          "object": "constraint \"profiles_locations_shape_c8b4dcae\" on \"profiles\""
        }
      }
    ],
    "execute": [
      {
        "description": "add check constraint \"profiles_locations_shape_c8b4dcae\"",
        "sql": "ALTER TABLE \"public\".\"profiles\" ADD CONSTRAINT \"profiles_locations_shape_c8b4dcae\" CHECK (\"locations\" IS NULL OR (jsonb_typeof(\"locations\") = 'object' AND \"locations\" ?& ARRAY['remote', 'hybrid', 'onsite'] AND (\"locations\" - ARRAY['remote', 'hybrid', 'onsite']) = '{}'::jsonb AND CASE WHEN jsonb_typeof(\"locations\" -> 'remote') = 'array' AND jsonb_typeof(\"locations\" -> 'hybrid') = 'array' AND jsonb_typeof(\"locations\" -> 'onsite') = 'array' THEN jsonb_array_length(\"locations\" -> 'remote') <= 20 AND jsonb_array_length(\"locations\" -> 'hybrid') <= 20 AND jsonb_array_length(\"locations\" -> 'onsite') <= 20 AND NOT jsonb_path_exists(\"locations\", '$.*[*] ? (@.type() != \"string\")') ELSE false END))"
      }
    ],
    "postcheck": [
      {
        "description": "verify check constraint \"profiles_locations_shape_c8b4dcae\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3) AND \"c\".\"contype\" = $4)) AS \"result\"",
        "params": [
          "profiles_locations_shape_c8b4dcae",
          "public",
          "\"public\".\"profiles\"",
          "c"
        ]
      }
    ]
  },
