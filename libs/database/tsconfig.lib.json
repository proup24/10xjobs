{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": [
    "vitest.config.mts",
    "src/migrations/**",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.mjs"
  ]
}
