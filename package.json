    "jobs:smoke": "pnpm --filter @xjobs/xjobs jobs:smoke",
    "test:redis": "REDIS_INTEGRATION=1 vitest run --config apps/xjobs/vitest.config.mts src/infrastructure/redis/redis.integration.spec.ts"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.0.0",
