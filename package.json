{
  "name": "@xjobs/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "test:hooks": "node --test \".claude/hooks/*.test.mjs\"",
    "users": "pnpm --filter @xjobs/xjobs users",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:test": "nx run @xjobs/db-tests:db-test",
    "db:types": "supabase gen types typescript --schema public > libs/database/src/supabase/database.types.ts && prettier --write libs/database/src/supabase/database.types.ts",
    "db:migrate": "pnpm --filter @xjobs/database db:migrate",
    "db:seed": "pnpm --filter @xjobs/database db:seed",
    "db:reset": "supabase stop --no-backup && supabase start && XJOBS_SKIP_ENV_FILES=1 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres pnpm --filter @xjobs/database db:migrate && eval \"$(scripts/supabase-env.sh)\" && XJOBS_SKIP_ENV_FILES=1 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres pnpm --filter @xjobs/database db:seed",
    "infra:redis": "docker compose up -d redis redis-cache",
    "start": "node apps/xjobs/dist/main.js",
    "start:dev": "pnpm --filter @xjobs/xjobs start:dev",
    "worker": "node apps/xjobs/dist/worker.js",
    "worker:dev": "pnpm --filter @xjobs/xjobs worker:dev",
    "worker:all": "WORKER_ROLE=all node apps/xjobs/dist/worker.js",
    "worker:all:dev": "pnpm --filter @xjobs/xjobs worker:all:dev",
    "worker:linkedin-job-board": "WORKER_CHANNEL=LINKEDIN_JOB_BOARD node apps/xjobs/dist/worker.js",
    "worker:linkedin-job-board:dev": "pnpm --filter @xjobs/xjobs worker:linkedin-job-board:dev",
    "worker:linkedin-posts": "WORKER_CHANNEL=LINKEDIN_POSTS node apps/xjobs/dist/worker.js",
    "worker:linkedin-posts:dev": "pnpm --filter @xjobs/xjobs worker:linkedin-posts:dev",
    "worker:greenhouse": "WORKER_CHANNEL=GREEN_HOUSE node apps/xjobs/dist/worker.js",
    "worker:greenhouse:dev": "pnpm --filter @xjobs/xjobs worker:greenhouse:dev",
    "worker:ashby": "WORKER_CHANNEL=ASHBY node apps/xjobs/dist/worker.js",
    "worker:ashby:dev": "pnpm --filter @xjobs/xjobs worker:ashby:dev",
    "worker:ingest": "WORKER_ROLE=ingest node apps/xjobs/dist/worker.js",
    "worker:ingest:dev": "pnpm --filter @xjobs/xjobs worker:ingest:dev",
    "jobs:smoke": "pnpm --filter @xjobs/xjobs jobs:smoke",
    "test:redis": "REDIS_INTEGRATION=1 vitest run --config apps/xjobs/vitest.config.mts src/infrastructure/redis/redis.integration.spec.ts"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^12.0.5",
    "@openrouter/sdk": "^1.5.33",
    "@sentry/node": "^11.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "apify-client": "^2.25.0",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "next": "~16.4.1",
    "pg-native": "^3.9.1",
    "prisma": "8.0.0-rc.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/docker": "24.0.2",
    "@nx/eslint": "24.0.2",
    "@nx/eslint-plugin": "24.0.2",
    "@nx/js": "24.0.2",
    "@nx/nest": "24.0.2",
    "@nx/next": "24.0.2",
    "@nx/node": "24.0.2",
    "@nx/vitest": "24.0.2",
    "@nx/web": "24.0.2",
    "@nx/webpack": "24.0.2",
    "@nx/workspace": "24.0.2",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~5.0.1",
    "@vitest/ui": "~5.0.1",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jsdom": "^27.1.0",
    "nx": "24.0.2",
    "prettier": "~3.6.2",
    "supabase": "3.0.0-next.27",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~5.0.1",
    "webpack": "~5.110.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "packageManager": "pnpm@12.15.0",
  "workspaces": [
    "apps/*"
  ]
}
