  ASHBY              = "ASHBY"
}

enum ProfileState {
  @@type("pg/text@1")
  draft     = "draft"
  published = "published"
}

// Postal address; `country` is ISO 3166-1 alpha-2.
type Address {
  line1      String
  line2      String?
  city       String
  postalCode String?
  state      String?
  country    String
}

// Every domain record belongs to a workspace, even in a single-user install.
model Workspace {
  id                  Uuid                 @id @onCreate(uuid(7))
  name                String
  slug                String               @unique
  querySearchBuilders QuerySearchBuilder[]
  +Timestamps

  @@check(expression: sql`slug ~ '^[a-z0-9-]{2,64}$'`, name: "workspaces_slug_format")
  @@map("workspaces")
}

model User {
  id          Uuid      @id @onCreate(uuid(7))
  workspaceId Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Stored lowercased; unique within the workspace.
  email       String
  name        String
  address     Address?
  +Timestamps

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("users")
}

// The user's own contact channels, the ones that go on applications.
model Contact {
  id          Uuid        @id @onCreate(uuid(7))
  workspaceId Uuid
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        ContactKind
  value       String
  label       String?
  isPrimary   Boolean     @default(false)
  +Timestamps

  @@unique([userId, kind, value])
  @@index([workspaceId])
  @@index([userId])
  @@map("contacts")
}

// The job-seeker profile qualify compares jobs against. One per user.
// Timezone offsets are minutes from UTC.
model Profile {
  id                Uuid          @id @onCreate(uuid(7))
  workspaceId       Uuid
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId            Uuid          @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions         Position[]
  languages         Language[]
  country           String
  city              String?
  regions           Region[]
  yearsOfExperience Int
  timezoneCurrent   Int
  timezoneMin       Int
  timezoneMax       Int
  engagements       Engagement[]
  arrangements      Arrangement[]
  seniority         Seniority
  noticePeriodDays  Int
  resumeKey         String?
  resumeFilename    String?
  resumeSizeBytes   Int?
  resumeSha256      String?
  resumeUploadedAt  TimestamptzJsDate(3)?
  state             ProfileState  @default(draft)
  publishedAt       TimestamptzJsDate(3)?
  +Timestamps

  @@check(expression: sql`"yearsOfExperience" BETWEEN 0 AND 60`, name: "profiles_years_range")
  @@check(expression: sql`"noticePeriodDays" BETWEEN 0 AND 365`, name: "profiles_notice_range")
  @@check(expression: sql`"timezoneCurrent" BETWEEN -720 AND 840 AND "timezoneMin" BETWEEN -720 AND 840 AND "timezoneMax" BETWEEN -720 AND 840 AND "timezoneMin" <= "timezoneMax"`, name: "profiles_tz_range")
  @@check(expression: sql`cardinality("positions") > 0`, name: "profiles_positions_nonempty")
  @@check(expression: sql`cardinality("languages") > 0`, name: "profiles_languages_nonempty")
  @@check(expression: sql`cardinality("engagements") > 0`, name: "profiles_engagements_nonempty")
  @@check(expression: sql`cardinality("arrangements") > 0`, name: "profiles_arrangements_nonempty")
  @@index([workspaceId])
  @@map("profiles")
}

// One row per technology and domain in a profile's tech stack.
model ProfileSkill {
  id          Uuid        @id @onCreate(uuid(7))
  workspaceId Uuid
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profileId   Uuid
  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  technology  Technology
  domain      SkillDomain
  mastery     Int
  preference  Int
  importance  Int         @default(5)
  +Timestamps

  @@check(expression: sql`mastery BETWEEN 0 AND 10`, name: "profile_skills_mastery_range")
  @@check(expression: sql`preference BETWEEN 0 AND 10`, name: "profile_skills_preference_range")
  @@check(expression: sql`importance BETWEEN 0 AND 10`, name: "profile_skills_importance_range")
  @@unique([profileId, technology, domain])
  @@index([workspaceId])
  @@map("profile_skills")
}

// A shared, immutable search recipe for one channel. Deduplicated by hash.
model QuerySearchBuilder {
  id             Uuid         @id @onCreate(uuid(7))
  workspaceId    Uuid
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel        Channel
  locationRegion Region
  country        String?
  city           String?
  experience     Seniority
  technologies   Technology[]
  type           Arrangement
  keywords       String[]
  version        Int
  params         Jsonb
  hash           String
  +Timestamps

  @@unique([workspaceId, hash])
  @@index([workspaceId, channel])
  @@map("query_search_builder")
}
