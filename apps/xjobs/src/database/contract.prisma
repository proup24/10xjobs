enum Channel {
  @@type("pg/text@1")
  LINKEDIN_JOB_BOARD = "LINKEDIN_JOB_BOARD"
  LINKEDIN_POSTS     = "LINKEDIN_POSTS"
  GREEN_HOUSE        = "GREEN_HOUSE"
  ASHBY              = "ASHBY"
}

enum ProfileState {
  @@type("pg/text@1")
  draft     = "draft"
  published = "published"
}

// Postal address; `country` is ISO 3166-1 alpha-2.
type Address {
  line1      String
  line2      String?
  city       String
  postalCode String?
  state      String?
  country    String
}

// One row per Supabase Auth user, created by the on_auth_user_created trigger.
// The email lives only in Auth.
model User {
  id          Uuid      @id
  authUser    supabase:auth.AuthUser @relation(fields: [id], references: [id], onDelete: Cascade)
  name        String?
  address     Address?
  +Timestamps

  @@map("users")
  @@rls
}

// Users read and update only their own row. No insert (the sign-up trigger does it) and
// no delete (removing the Auth user cascades).
policy_select users_owner_read {
  target = User
  roles  = [authenticated]
  using  = sql`id = auth.uid()`
}

policy_update users_owner_update {
  target    = User
  roles     = [authenticated]
  using     = sql`id = auth.uid()`
  withCheck = sql`id = auth.uid()`
}

// The user's own contact channels, the ones that go on applications.
model Contact {
  id          Uuid        @id @onCreate(uuid(7))
  userId      Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        ContactKind
  value       String
  label       String?
  isPrimary   Boolean     @default(false)
  +Timestamps

  @@unique([userId, kind, value])
  @@index([userId])
  @@map("contacts")
  @@rls
}

policy_all contacts_owner {
  target    = Contact
  roles     = [authenticated]
  using     = sql`"userId" = auth.uid()`
  withCheck = sql`"userId" = auth.uid()`
}

// A user may maintain multiple independent job-seeker profiles, one per target position.
// Timezone offsets are minutes from UTC.
model Profile {
  id                Uuid          @id @onCreate(uuid(7))
  userId            Uuid
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  position          Position
  languages         Language[]
  country           String
  city              String?
  regions           Region[]
  yearsOfExperience Int
  timezoneCurrent   Int
  timezoneMin       Int
  timezoneMax       Int
  engagements       Engagement[]
  arrangements      Arrangement[]
  seniority         Seniority
  noticePeriodDays  Int
  resumeKey         String?
  resumeFilename    String?
  resumeSizeBytes   Int?
  resumeSha256      String?
  resumeUploadedAt  TimestamptzJsDate(3)?
  state             ProfileState  @default(draft)
  publishedAt       TimestamptzJsDate(3)?
  +Timestamps

  @@check(expression: sql`"yearsOfExperience" BETWEEN 0 AND 60`, name: "profiles_years_range")
  @@check(expression: sql`"noticePeriodDays" BETWEEN 0 AND 365`, name: "profiles_notice_range")
  @@check(expression: sql`"timezoneCurrent" BETWEEN -720 AND 840 AND "timezoneMin" BETWEEN -720 AND 840 AND "timezoneMax" BETWEEN -720 AND 840 AND "timezoneMin" <= "timezoneMax"`, name: "profiles_tz_range")
  @@check(expression: sql`cardinality("languages") > 0`, name: "profiles_languages_nonempty")
  @@check(expression: sql`cardinality("engagements") > 0`, name: "profiles_engagements_nonempty")
  @@check(expression: sql`cardinality("arrangements") > 0`, name: "profiles_arrangements_nonempty")
  // Target of profile_skills' (profileId, userId) foreign key.
  @@unique([id, userId])
  @@index([userId])
  @@map("profiles")
}

// One row per technology and domain in a profile's tech stack.
// userId always equals the profile's userId: the (profileId, userId) foreign key enforces it.
model ProfileSkill {
  id          Uuid        @id @onCreate(uuid(7))
  userId      Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId   Uuid
  profile     Profile     @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
  technology  Technology
  domain      SkillDomain
  mastery     Int
  importance  Int         @default(5)
  +Timestamps

  @@check(expression: sql`mastery BETWEEN 0 AND 10`, name: "profile_skills_mastery_range")
  @@check(expression: sql`importance BETWEEN 0 AND 10`, name: "profile_skills_importance_range")
  @@unique([profileId, technology, domain])
  @@index([userId])
  @@map("profile_skills")
}

// A shared, immutable search recipe for one channel, deduplicated by hash across every
// profile. Profiles use it through ProfileQuerySearchBuilder; rows are never hard-deleted,
// because raw job hits are attributed to them.
model QuerySearchBuilder {
  id                 Uuid         @id @onCreate(uuid(7))
  channel            Channel
  locationRegion     Region?
  country            String?
  city               String?
  experience         Seniority
  technologies       Technology[]
  type               Arrangement
  keyword            String
  version            Int
  params             Jsonb
  hash               String
  // Number of ProfileQuerySearchBuilder rows; kept in step under a row lock.
  associatedProfiles Int          @default(0)
  // Collected only while active: at least one published profile uses it.
  isActive           Boolean      @default(false)
  // Soft delete: retired recipes are never collected, linked or listed again.
  isDeleted          Boolean      @default(false)
  +Timestamps

  @@check(expression: sql`"associatedProfiles" >= 0`, name: "query_search_builder_associated_profiles")
  @@check(expression: sql`NOT ("isDeleted" AND "isActive")`, name: "query_search_builder_deleted_inactive")
  @@unique([hash])
  @@index([channel, isActive, isDeleted])
  @@map("query_search_builder")
}

// Which published profiles use which shared query search builder.
model ProfileQuerySearchBuilder {
  id        Uuid               @id @onCreate(uuid(7))
  profileId Uuid
  profile   Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  queryId   Uuid
  query     QuerySearchBuilder @relation(fields: [queryId], references: [id], onDelete: Cascade)
  createdAt TimestamptzJsDate(3) @default(now())

  @@unique([profileId, queryId])
  @@index([queryId])
  @@map("profile_query_search_builders")
}

// Shared source observations. Ownership belongs to lookup attribution, not jobs.
model RawJob {
  id                   Uuid @id @onCreate(uuid(7))
  channel              Channel
  kind                 String
  externalId           String?
  url                  String
  applyUrl             String?
  title                String?
  company              String?
  location             String?
  description          String
  postedAt             TimestamptzJsDate(3)?
  postedAtPrecision    String?
  authorName           String?
  authorUrl            String?
  contactName          String?
  contactUrl           String?
  raw                  Jsonb
  normalizationVersion Int
  firstSeenAt          TimestamptzJsDate(3)
  lastSeenAt           TimestamptzJsDate(3)
  atsPostingId         Uuid?
  atsPosting           AtsPostingIdentity? @relation(fields: [atsPostingId], references: [id], onDelete: SetNull)

  @@check(expression: sql`kind IN ('job', 'post')`, name: "raw_jobs_kind")
  @@check(expression: sql`"postedAtPrecision" IN ('hour', 'day')`, name: "raw_jobs_precision")
  @@check(expression: sql`"firstSeenAt" <= "lastSeenAt"`, name: "raw_jobs_seen_order")
  @@check(expression: sql`length(trim(description)) > 0 AND length(trim(url)) > 0`, name: "raw_jobs_content")
  @@index([channel, lastSeenAt])
  @@map("raw_jobs")
}

// Aliases permit URL-only observations to acquire source IDs atomically.
model RawJobIdentity {
  id            Uuid @id @onCreate(uuid(7))
  channel       Channel
  identityType  String
  identityValue String
  rawJobId      Uuid
  rawJob        RawJob @relation(fields: [rawJobId], references: [id], onDelete: Cascade)

  @@check(expression: sql`"identityType" IN ('source_id', 'url')`, name: "raw_job_identity_type")
  @@check(expression: sql`length(trim("identityValue")) > 0`, name: "raw_job_identity_value")
  @@unique([channel, identityType, identityValue])
  @@map("raw_job_identities")
}

model RawJobQueryHit {
  id          Uuid @id @onCreate(uuid(7))
  queryId     Uuid
  query       QuerySearchBuilder @relation(fields: [queryId], references: [id], onDelete: Cascade)
  rawJobId    Uuid
  rawJob      RawJob @relation(fields: [rawJobId], references: [id], onDelete: Cascade)
  firstSeenAt TimestamptzJsDate(3)
  lastSeenAt  TimestamptzJsDate(3)
  observedUrl String
  rank        Int?

  @@check(expression: sql`"firstSeenAt" <= "lastSeenAt"`, name: "raw_job_query_hits_seen_order")
  @@check(expression: sql`rank IS NULL OR rank > 0`, name: "raw_job_query_hits_rank")
  @@unique([queryId, rawJobId])
  @@map("raw_job_query_hits")
}

// Association only: observations from different channels remain separate.
model AtsPostingIdentity {
  id        Uuid @id @onCreate(uuid(7))
  provider  String
  tenantKey String
  postingId String

  @@check(expression: sql`provider IN ('ashby', 'greenhouse')`, name: "ats_posting_identity_provider")
  @@unique([provider, tenantKey, postingId])
  @@map("ats_posting_identities")
}
