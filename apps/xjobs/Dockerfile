# Generated by Nx, then edited: the base image is pinned to Node 24, the
# version CI tests with (`lts` floats to whatever is current).
# Build the docker image with `npx nx docker:build @xjobs/xjobs`.
# Tip: Modify "docker:build" options in project.json to change docker build args.
#
# Run the container with `nx docker:run @xjobs/xjobs -p 3000:3000`.
#
FROM docker.io/node:24-alpine

ENV HOST=0.0.0.0
ENV PORT=3000


WORKDIR /app

COPY dist .

# You can remove this install step if you build with `--bundle` option.
# The bundled output will include external dependencies.

RUN npm --omit=dev -f install

# Claude Code runs the processor (`claude -p`). The version must equal
# CLAUDE_CODE_VERSION in src/modules/processor/models/claude/version.ts
# (a spec checks this line). Upgrading is a deliberate bump of both.
RUN npm install -g @anthropic-ai/claude-code@2.1.314
ENV DISABLE_AUTOUPDATER=1

CMD [ "node", "main.js" ]
