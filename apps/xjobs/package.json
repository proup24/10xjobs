{
  "name": "@xjobs/xjobs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "db:emit": "prisma contract emit",
    "db:format": "prisma contract format",
    "db:update": "prisma db update",
    "db:init": "prisma db init",
    "db:migration:plan": "prisma contract emit && prisma migration plan",
    "db:migration:status": "prisma migration status",
    "db:migrate": "prisma db migrate --to db",
    "db:migrate:show": "prisma db migrate --show",
    "db:verify": "prisma db verify",
    "users": "tsx --tsconfig tsconfig.app.json src/admin/users-cli.ts",
    "db:seed": "tsx --tsconfig tsconfig.app.json src/database/seeds/index.ts",
    "db:regenerate": "tsx --tsconfig tsconfig.app.json src/scripts/regenerate-query-search.ts",
    "db:renormalize": "tsx --tsconfig tsconfig.app.json src/scripts/renormalize-jobs.ts",
    "db:reprocess": "tsx --tsconfig tsconfig.app.json src/scripts/reprocess-jobs.ts",
    "db:vocab": "tsx --tsconfig tsconfig.app.json src/scripts/vocab.ts",
    "processor:golden-import": "tsx --tsconfig tsconfig.app.json src/scripts/processor-golden-import.ts",
    "processor:golden-draft": "tsx --tsconfig tsconfig.app.json src/scripts/processor-golden-draft.ts",
    "processor:eval": "tsx --tsconfig tsconfig.app.json src/scripts/processor-eval.ts",
    "processor:smoke": "tsx --tsconfig tsconfig.app.json src/scripts/processor-smoke.ts",
    "apify:probe-linkedin": "tsx --tsconfig tsconfig.app.json src/scripts/probe-linkedin-search.ts",
    "start": "node dist/main.js",
    "start:dev": "tsx watch --tsconfig tsconfig.app.json src/main.ts",
    "worker:dev": "tsx watch --tsconfig tsconfig.app.json src/worker.ts",
    "worker:all:dev": "WORKER_ROLE=all tsx watch --tsconfig tsconfig.app.json src/worker.ts",
    "worker:linkedin-job-board:dev": "WORKER_CHANNEL=LINKEDIN_JOB_BOARD tsx watch --tsconfig tsconfig.app.json src/worker.ts",
    "worker:linkedin-posts:dev": "WORKER_CHANNEL=LINKEDIN_POSTS tsx watch --tsconfig tsconfig.app.json src/worker.ts",
    "worker:greenhouse:dev": "WORKER_CHANNEL=GREEN_HOUSE tsx watch --tsconfig tsconfig.app.json src/worker.ts",
    "worker:ashby:dev": "WORKER_CHANNEL=ASHBY tsx watch --tsconfig tsconfig.app.json src/worker.ts",
    "worker:ingest:dev": "WORKER_ROLE=ingest tsx watch --tsconfig tsconfig.app.json src/worker.ts",
    "worker:processor:dev": "WORKER_ROLE=processor tsx watch --tsconfig tsconfig.app.json src/worker.ts",
    "jobs:smoke": "JOBS_SMOKE=1 vitest run --config vitest.config.mts src/infrastructure/jobs/tests/smoke.spec.ts"
  },
  "nx": {
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/xjobs/dist/package.json",
          "{workspaceRoot}/apps/xjobs/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/xjobs/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "readyWhen": {
          "signal": true
        },
        "options": {
          "buildTarget": "@xjobs/xjobs:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@xjobs/xjobs:build:development"
          },
          "production": {
            "buildTarget": "@xjobs/xjobs:build:production"
          }
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      },
      "worker": {
        "continuous": true,
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/xjobs/dist/worker.js"
        }
      },
      "worker-all": {
        "continuous": true,
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/xjobs/dist/worker.js",
          "env": {
            "WORKER_ROLE": "all"
          }
        }
      },
      "worker-processor": {
        "continuous": true,
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/xjobs/dist/worker.js",
          "env": {
            "WORKER_ROLE": "processor"
          }
        }
      },
      "worker-linkedin-job-board": {
        "continuous": true,
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/xjobs/dist/worker.js",
          "env": {
            "WORKER_CHANNEL": "LINKEDIN_JOB_BOARD"
          }
        }
      },
      "worker-linkedin-posts": {
        "continuous": true,
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/xjobs/dist/worker.js",
          "env": {
            "WORKER_CHANNEL": "LINKEDIN_POSTS"
          }
        }
      },
      "worker-greenhouse": {
        "continuous": true,
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/xjobs/dist/worker.js",
          "env": {
            "WORKER_CHANNEL": "GREEN_HOUSE"
          }
        }
      },
      "worker-ashby": {
        "continuous": true,
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/xjobs/dist/worker.js",
          "env": {
            "WORKER_CHANNEL": "ASHBY"
          }
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^12.0.5",
    "@openrouter/sdk": "1.5.33",
    "@prisma/orm-extension-supabase": "8.0.0-rc.21",
    "@prisma/orm-postgres": "8.0.0-rc.21",
    "@sentry/node": "^11.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "html-to-text": "9.0.5",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@prisma/cli-engine": "0.9.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/html-to-text": "9.0.4",
    "prisma": "8.0.0-rc.28",
    "tsx": "^4.23.15"
  }
}