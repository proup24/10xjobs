{
  "name": "@xjobs/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "web",
    "sourceRoot": "apps/web/src",
    "targets": {
      "dev": {
        "options": {
          "command": "next dev --port 3001"
        }
      },
      "start": {
        "options": {
          "command": "next start --port 3001"
        }
      },
      "test-live": {
        "command": "vitest run -c vitest.live.config.mts",
        "options": {
          "cwd": "apps/web"
        },
        "cache": false
      },
      "typecheck": {
        "command": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json",
        "options": {
          "cwd": "apps/web"
        },
        "cache": true,
        "dependsOn": [
          "^typecheck"
        ],
        "inputs": [
          "default",
          "^production"
        ]
      }
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@xjobs/database": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.66.0",
    "next": "~16.4.1",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  }
}
