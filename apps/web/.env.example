NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shared dev database: see docs/shared-dev-database.md. To use it, replace the
# two values above with these.
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Engine (server-only, never NEXT_PUBLIC_). ENGINE_API_KEY: same value as the
# engine's ENGINE_API_KEY; server-only.
ENGINE_URL=http://localhost:3000
ENGINE_API_KEY=
